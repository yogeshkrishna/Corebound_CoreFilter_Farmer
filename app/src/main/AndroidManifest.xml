<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <queries><package android:name="com.Overcurve.Corebound" /></queries>
    <application android:allowBackup="false" android:dataExtractionRules="@xml/no_backup" android:label="Core Filter Pilot"
        android:theme="@style/AppTheme" android:supportsRtl="true"
        android:usesCleartextTraffic="false" android:icon="@drawable/ic_pilot">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CalibrationActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />
        <service android:name=".PilotService" android:exported="true"
            android:label="Core Filter Pilot controls"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pilot_service" />
        </service>
        <provider android:name=".DiagnosticProvider" android:authorities="${applicationId}.diagnostics"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
